{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nexo-play/ofertas",
	"title": "Descuentos y eventos",
	"category": "nexo-play",
	"icon": "tag",
	"description": "Tarjetas de ofertas con su etiqueta y porcentaje de descuento.",
	"textdomain": "nexo-play",
	"attributes": {
		"titulo": {
			"type": "string",
			"default": "Descuentos y eventos"
		},
		"cantidad": {
			"type": "number",
			"default": 12
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		}
	},
	"editorScript": "np-bloques-editor",
	"render": "file:./render.php"
}